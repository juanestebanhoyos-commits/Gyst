{
  "expo": {
    "name": "Gyst",
    "slug": "gyst",
    "version": "1.0.0",
    "scheme": "gyst",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-status-bar",
      "expo-router",
      "expo-font",
      "expo-splash-screen"
    ],
    "ios": {
      "bundleIdentifier": "com.juanestebanhoyos.gyst",
      "supportsTablet": true
    },
    "android": {
      "package": "com.juanestebanhoyos.gyst",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#131313"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7305a5cd-dcf5-4abe-8123-0259bbc6ef9c"
      }
    },
    "owner": "juanestebanhoyos-commits"
  }
}
